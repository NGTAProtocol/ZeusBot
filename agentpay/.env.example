# --- Analisi ---
# Chiave API Anthropic (opzionale). Senza chiave AgentPay usa la modalità euristica.
ANTHROPIC_API_KEY=
# Modello Claude per l'analisi LLM (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Fix Pack cifrato ---
# Chiave AES-256-GCM: 32 byte casuali in base64. Obbligatoria con Stripe attivo.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PACK_SECRET=

# --- Pagamenti Stripe (se una delle due manca: modalità DEMO con pagamento simulato) ---
# Chiave ristretta con SOLO lettura sulle Checkout Sessions (rk_live_... o rk_test_...)
STRIPE_SECRET_KEY=
# Payment Link da €9 con redirect di successo: https://TUO-DOMINIO/?session_id={CHECKOUT_SESSION_ID}
STRIPE_PAYMENT_LINK_URL=
# Email mostrata se il cliente torna dal pagamento senza i dati della scansione
SUPPORT_EMAIL=

# --- Server locale ---
PORT=3000
