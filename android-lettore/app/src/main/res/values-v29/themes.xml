<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Segue il tema chiaro/scuro del telefono (anche la pagina lo rileva). -->
    <style name="Tema" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/sfondo</item>
        <item name="android:statusBarColor">@color/sfondo</item>
        <item name="android:navigationBarColor">@color/sfondo</item>
        <item name="android:windowLightStatusBar">@bool/barra_chiara</item>
    </style>
</resources>
