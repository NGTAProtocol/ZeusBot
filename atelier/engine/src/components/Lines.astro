---
// Titolo spezzato in righe con maschera; testo accessibile intatto.
const { lines, tag = 'h2', class: cls = '', id } = Astro.props;
const Tag = tag;
const full = lines.join(' ');
---
<Tag class={cls} id={id} data-reveal-lines>
  <span class="sr-only">{full}</span>
  <span aria-hidden="true">
    {lines.map((line) => <span class="mask-line"><span>{line}</span></span>)}
  </span>
</Tag>
