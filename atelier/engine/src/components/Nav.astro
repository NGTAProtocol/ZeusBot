---
import site from '../generated/site.json';
const { content } = site;
const base = import.meta.env.BASE_URL;
const href = (h) => (h.startsWith('#') || h.startsWith('http') || h.startsWith('mailto:') || h.startsWith('tel:') ? h : base + h.replace(/^\//, ''));
---
<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__brand" href={base}>{content.brand.name}</a>
    <nav aria-label="Principale">
      <ul class="nav__links">
        {content.nav.map((l) => <li><a href={href(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-primary nav__cta" href={href(content.cta.href)}>{content.cta.label}</a>
    <button class="nav__menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>Menu</button>
  </div>
</header>
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" data-menu hidden>
  <div class="menu__top">
    <span class="nav__brand">{content.brand.name}</span>
    <button class="menu__close" type="button" data-menu-close>Chiudi</button>
  </div>
  <ul>
    {content.nav.map((l) => <li><a href={href(l.href)} data-menu-link>{l.label}</a></li>)}
    <li><a href={href(content.cta.href)} data-menu-link>{content.cta.label}</a></li>
  </ul>
  <p>{content.footer.email}</p>
</div>
