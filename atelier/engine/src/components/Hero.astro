---
import site from '../generated/site.json';
import Lines from './Lines.astro';
import { posterSvg } from '../lib/poster.js';
const { hero } = Astro.props;
const { content, direction, level } = site;
const svg = posterSvg(direction, content.brand.name);
// dimensione del titolo in base alla riga più lunga: resta su righe intere e lascia la CTA sopra la piega
const longest = Math.max(...hero.title_lines.map((l) => l.length));
const heroStyle = `--hero-chars: ${longest};`;
const base = import.meta.env.BASE_URL;
const href = (h) => (h.startsWith('#') || h.startsWith('http') || h.startsWith('mailto:') ? h : base + h.replace(/^\//, ''));
---
<section class="hero" aria-labelledby="hero-title" data-hero style={heroStyle}>
  <div class="hero__art" data-hero-art data-motif={direction.hero3d.motif}>
    <div class="hero__poster" set:html={svg} />
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <Lines lines={hero.title_lines} tag="h1" class="hero__title" kinetic={level === 'cinematic'} />
    <div class="hero__text">
      <p class="hero__lead">{hero.lead}</p>
      <p class="hero__lead hero__lead--short">{hero.lead_short}</p>
    </div>
    <div class="hero__actions">
      <a class="btn btn-primary" href={href(hero.cta.href)}>{hero.cta.label}</a>
      {hero.secondary && <a class="btn btn-ghost" href={href(hero.secondary.href)}>{hero.secondary.label}</a>}
    </div>
    {hero.meta && <p class="hero__meta">{hero.meta.map((m) => <span>{m}</span>)}</p>}
  </div>
</section>
